PORT=8787
# Cloudflare Tunnel (nur für docker-compose.tunnel.yml)
TUNNEL_TOKEN=
# Öffentliche URL dieses Servers (für OAuth-Redirects, Media-URLs, Tracking-Links)
PUBLIC_URL=https://api.example.com
# Erlaubte Frontend-Origin(s), kommagetrennt
CORS_ORIGIN=https://studio.example.com
JWT_SECRET=bitte-lang-und-zufaellig
# 32 Byte hex für AES-256-GCM (Plattform-Tokens verschlüsselt speichern): openssl rand -hex 32
TOKEN_KEY=
DATA_DIR=./data
# Ordner mit Beispiel-Assets des Frontends (assets/…), damit der Renderer sie findet
ASSET_ROOT=..
FFMPEG=ffmpeg

# URL der Ad-Studio-App (für Links in Mails)
APP_URL=https://studio.example.com/Ad%20Studio.dc.html
# Mails über resend.com
RESEND_API_KEY=
MAIL_FROM=Ad Studio <noreply@example.com>

# Registrierung: invite (nur mit Einladung) oder open
REGISTRATION=invite

# Plattform-Admin (wird beim ersten Start angelegt; Passwort danach hier löschen)
SUPERADMIN_EMAIL=l.burczyk@pq-world.de
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=L. Burczyk
SUPERADMIN_ORG=PQ World

# Stripe – dashboard.stripe.com (Produkte & Preise anlegen, IDs hier eintragen)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=
STRIPE_PRICE_ADDON_KI500=
STRIPE_PRICE_ADDON_SEAT=
STRIPE_PRICE_ADDON_WHITELABEL=

# Meta (Instagram Graph API, Content Publishing) – developers.facebook.com
META_APP_ID=
META_APP_SECRET=
# TikTok Content Posting API – developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Google / YouTube Data API v3 – console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
